{
  "name": "neromusic-showcase",
  "version": "1.0.0",
  "private": true,
  "description": "Public engineering showcase and generic Node.js samples",
  "type": "commonjs",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "test": "node --test samples/**/*.test.js",
    "demo": "node samples/llm-fallback/demo.js && node samples/state-reconciler/demo.js && node samples/sqlite-migrations/demo.js",
    "lint": "eslint samples",
    "typecheck": "tsc --project tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.43",
    "eslint": "^10.15.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
